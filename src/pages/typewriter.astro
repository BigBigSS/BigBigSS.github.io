---
import "../styles/global.css";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="一台可交互、可动画、可导出的积木机械打字机 Three.js 模型。"
    />
    <title>Brick Typewriter · Three.js</title>
  </head>
  <body>
    <main class="typewriter-app" data-typewriter-app>
      <div class="scene" data-scene aria-label="积木机械打字机 3D 场景">
        <canvas data-canvas></canvas>
        <div class="loading" data-loading>
          <span class="loading__mark" aria-hidden="true"></span>
          <span>ASSEMBLING</span>
        </div>
      </div>

      <header class="masthead">
        <a class="back" href="/lab" aria-label="返回实验室" title="返回实验室">←</a>
        <div class="identity">
          <p>PROCEDURAL OBJECT / 01</p>
          <h1>Brick Typewriter</h1>
        </div>
        <div class="status" aria-live="polite">
          <span class="status__dot"></span>
          <span data-status>READY</span>
        </div>
      </header>

      <aside class="details" aria-label="模型信息">
        <p>MECHANICAL / ABS / 1984</p>
        <dl>
          <div><dt>PARTS</dt><dd data-part-count>000</dd></div>
          <div><dt>KEYS</dt><dd>44</dd></div>
          <div><dt>PALETTE</dt><dd>R/Y/K</dd></div>
        </dl>
      </aside>

      <nav class="toolbar" aria-label="模型控制">
        <button
          class="tool"
          type="button"
          data-action="print"
          aria-label="播放打字动画"
          title="播放打字动画"
        >
          <span aria-hidden="true">▶</span>
        </button>
        <button
          class="tool"
          type="button"
          data-action="explode"
          aria-label="切换爆炸视图"
          title="切换爆炸视图"
          aria-pressed="false"
        >
          <span aria-hidden="true">✣</span>
        </button>
        <button
          class="tool"
          type="button"
          data-action="rotate"
          aria-label="切换自动旋转"
          title="切换自动旋转"
          aria-pressed="false"
        >
          <span aria-hidden="true">↻</span>
        </button>
        <button
          class="tool"
          type="button"
          data-action="reset"
          aria-label="复位视角"
          title="复位视角"
        >
          <span aria-hidden="true">⌂</span>
        </button>
        <button
          class="tool"
          type="button"
          data-action="reference"
          aria-label="查看参考图"
          title="查看参考图"
          aria-pressed="false"
        >
          <span aria-hidden="true">◫</span>
        </button>
        <button
          class="tool"
          type="button"
          data-action="download"
          aria-label="下载 GLB 模型"
          title="下载 GLB 模型"
        >
          <span aria-hidden="true">↓</span>
        </button>
      </nav>

      <div class="palette" aria-label="模型配色">
        <span class="swatch swatch--red" title="Signal red"></span>
        <span class="swatch swatch--yellow" title="Sun yellow"></span>
        <span class="swatch swatch--black" title="Machine black"></span>
      </div>

      <aside class="reference" data-reference aria-hidden="true">
        <div class="reference__bar">
          <span>REFERENCE / APPROVED</span>
          <button type="button" data-reference-close aria-label="关闭参考图" title="关闭">×</button>
        </div>
        <img
          src="/typewriter/reference.png"
          width="1536"
          height="1024"
          alt="红黄积木机械打字机概念参考图"
        />
      </aside>
    </main>

    <script src="../scripts/brick-typewriter.ts"></script>
  </body>
</html>

<style>
  :global(html) {
    overflow: hidden;
    background: #e8e5df;
    color-scheme: light;
  }

  :global(body) {
    min-height: 100dvh;
    overflow: hidden;
    background: #e8e5df;
    color: #151515;
  }

  .typewriter-app {
    --ink: #151515;
    --paper: #e8e5df;
    --red: #ed1c24;
    --yellow: #ffc400;
    position: relative;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
  }

  .typewriter-app::after {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg, rgba(21, 21, 21, 0.045) 1px, transparent 1px),
      linear-gradient(rgba(21, 21, 21, 0.045) 1px, transparent 1px);
    background-size: 42px 42px;
    content: "";
    pointer-events: none;
    mask-image: linear-gradient(to bottom, #000, transparent 72%);
  }

  .scene,
  .scene canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scene {
    z-index: 1;
  }

  .scene canvas {
    display: block;
    touch-action: none;
  }

  .masthead {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 18px;
    align-items: start;
    padding: 24px 28px;
    border-bottom: 1px solid rgba(21, 21, 21, 0.16);
    pointer-events: none;
  }

  .back,
  .tool,
  .reference button {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .back {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(21, 21, 21, 0.28);
    font-size: 1.15rem;
    line-height: 1;
    pointer-events: auto;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .back:hover,
  .back:focus-visible {
    background: var(--ink);
    color: var(--paper);
    outline: none;
  }

  .identity {
    padding-top: 2px;
  }

  .identity p,
  .details > p,
  .status,
  .reference__bar {
    margin: 0;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .identity h1 {
    margin: 3px 0 0;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
  }

  .status {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    padding-top: 13px;
  }

  .status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
    box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.14);
  }

  .details {
    position: absolute;
    bottom: 28px;
    left: 28px;
    z-index: 5;
    width: min(340px, calc(100vw - 56px));
    pointer-events: none;
  }

  .details > p {
    margin-bottom: 10px;
  }

  .details dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid rgba(21, 21, 21, 0.3);
  }

  .details dl div {
    display: grid;
    gap: 2px;
    padding: 10px 12px 0 0;
  }

  .details dt {
    color: rgba(21, 21, 21, 0.58);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
  }

  .details dd {
    margin: 0;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .toolbar {
    position: absolute;
    right: 28px;
    bottom: 28px;
    z-index: 6;
    display: grid;
    grid-template-columns: repeat(6, 46px);
    border: 1px solid rgba(21, 21, 21, 0.35);
    background: rgba(232, 229, 223, 0.88);
    backdrop-filter: blur(14px);
  }

  .tool {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-right: 1px solid rgba(21, 21, 21, 0.22);
    font-family: system-ui, sans-serif;
    font-size: 1rem;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .tool:last-child {
    border-right: 0;
  }

  .tool:hover,
  .tool:focus-visible,
  .tool[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    outline: none;
  }

  .palette {
    position: absolute;
    top: 114px;
    right: 28px;
    z-index: 5;
    display: flex;
    gap: 5px;
  }

  .swatch {
    width: 11px;
    height: 11px;
    border: 1px solid rgba(21, 21, 21, 0.34);
  }

  .swatch--red { background: var(--red); }
  .swatch--yellow { background: var(--yellow); }
  .swatch--black { background: var(--ink); }

  .loading {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: grid;
    gap: 14px;
    place-content: center;
    justify-items: center;
    background: var(--paper);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    transition:
      opacity 500ms ease,
      visibility 500ms ease;
  }

  .loading.is-hidden {
    visibility: hidden;
    opacity: 0;
  }

  .loading__mark {
    width: 32px;
    height: 32px;
    border: 6px solid var(--yellow);
    border-top-color: var(--red);
    animation: loading-spin 900ms steps(8) infinite;
  }

  .reference {
    position: absolute;
    top: 92px;
    right: 28px;
    z-index: 10;
    width: min(460px, calc(100vw - 56px));
    border: 1px solid rgba(21, 21, 21, 0.45);
    background: #f6f4ef;
    box-shadow: 12px 12px 0 rgba(21, 21, 21, 0.12);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms ease;
  }

  .reference.is-open {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  .reference__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 10px 9px 13px;
    border-bottom: 1px solid rgba(21, 21, 21, 0.25);
  }

  .reference button {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    font-size: 1.2rem;
  }

  .reference img {
    width: 100%;
    height: auto;
  }

  @keyframes loading-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 800px) {
    .masthead {
      grid-template-columns: 40px minmax(0, 1fr);
      padding: 16px;
    }

    .back {
      width: 40px;
      height: 40px;
    }

    .status,
    .palette {
      display: none;
    }

    .identity p {
      font-size: 0.56rem;
    }

    .identity h1 {
      font-size: 1.15rem;
    }

    .details {
      bottom: 78px;
      left: 16px;
      width: 220px;
    }

    .details > p {
      display: none;
    }

    .details dl {
      grid-template-columns: repeat(3, 1fr);
    }

    .toolbar {
      right: 16px;
      bottom: 16px;
      left: 16px;
      grid-template-columns: repeat(6, 1fr);
    }

    .tool {
      width: 100%;
      height: 44px;
    }

    .reference {
      top: 76px;
      right: 16px;
      width: calc(100vw - 32px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading__mark {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    :global(html.lab-mobile-embed) .masthead { display: none; }
    :global(html.lab-mobile-embed) .toolbar { inset: auto 12px 12px; }
    :global(html.lab-mobile-embed) .details { left: 12px; bottom: 70px; }
    :global(html.lab-mobile-embed) .reference { top: 12px; right: 12px; width: calc(100vw - 24px); }
  }

  @media (max-width: 768px) and (max-height: 430px) {
    :global(html.lab-mobile-embed) .details { display: none; }
  }
</style>
