---
import { getCollection } from "astro:content";
import LabPreviewWheel from "../../components/LabPreviewWheel.astro";
import { site } from "../../data/site";
import { sortByDateDesc } from "../../lib/content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const labs = sortByDateDesc(
  (await getCollection("labs")).filter((lab) => !lab.data.draft),
);

const formatLabDate = (d: Date) =>
  new Intl.DateTimeFormat("en-CA", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  })
    .format(d)
    .replaceAll("-", ".");

const loopCycles = [-1, 0, 1] as const;
---

<BaseLayout
  title={`实验室 · ${site.name}`}
  description="hui 收集的交互动效实验：每一个条目都是一个能跑起来的现场演示。"
>
  <section class="lab-page">
    <header class="lab-masthead">
      <h1 class="lab-title">实验室</h1>
    </header>

    <div class="lab-stage" data-lab-stage>
      <div
        class="lab-list-viewport"
        data-lab-scroll
        tabindex="0"
        aria-label="实验项目列表，可上下滚动"
      >
        <ol class="lab-index" role="list" data-lab-list>
          {
            loopCycles.flatMap((cycle) =>
              labs.map((lab, idx) => (
                <li
                  data-lab-entry
                  data-index={idx}
                  data-cycle={cycle}
                  aria-hidden={cycle === 0 ? undefined : "true"}
                >
                  <a
                    class="entry"
                    href={`/lab/${lab.id}`}
                    tabindex={cycle === 0 ? undefined : -1}
                  >
                    <span class="entry__no" aria-hidden="true">
                      №{String(idx + 1).padStart(2, "0")}
                    </span>
                    <div class="entry__main">
                      <h2 class="entry__title">{lab.data.title}</h2>
                      {lab.data.tags.length > 0 && (
                        <ul class="entry__tags">
                          {lab.data.tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                    <span class="entry__meta">
                      <span>{formatLabDate(lab.data.date)}</span>
                      <span class="entry__sep" aria-hidden="true">/</span>
                      <span>LIVE DEMO</span>
                    </span>
                    <span class="entry__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              )),
            )
          }

          {labs.length === 0 && <li class="lab-empty">No experiments yet.</li>}
        </ol>
      </div>

      <LabPreviewWheel labs={labs} />
    </div>
  </section>
</BaseLayout>

<style>
  .lab-page {
    --lab-line: color-mix(in srgb, var(--text-primary) 14%, transparent);
    --lab-row-hover: color-mix(in srgb, var(--text-primary) 3.5%, transparent);
    --lab-stage-shift: clamp(76px, 7vw, 112px);

    width: min(880px, calc(100vw - 48px));
    margin-inline: auto;
    padding: clamp(72px, 10vw, 130px) 0 clamp(80px, 12vw, 140px);
  }

  .lab-masthead {
    display: flex;
    align-items: center;
  }

  .lab-title {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    margin: 0;
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lab-title::before {
    width: 20px;
    height: 1px;
    background: currentColor;
    content: "";
    opacity: 0.55;
  }

  .lab-stage {
    position: relative;
    width: 100%;
    margin-top: clamp(30px, 5vw, 44px);
  }

  .lab-list-viewport {
    width: 100%;
  }

  .lab-list-viewport:focus-visible {
    outline: 1px solid
      color-mix(in srgb, var(--text-primary) 25%, transparent);
    outline-offset: 8px;
  }

  .lab-index {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--lab-line);
  }

  .lab-index > li {
    display: block;
  }

  .lab-index > [data-cycle="-1"],
  .lab-index > [data-cycle="1"] {
    display: none;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto 24px;
    grid-template-areas: "no main meta arrow";
    column-gap: 28px;
    align-items: baseline;
    padding: clamp(26px, 3.6vw, 34px) 0;
    border-bottom: 1px solid var(--lab-line);
    color: inherit;
    text-decoration: none;
  }

  .entry::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: transparent;
    content: "";
    pointer-events: none;
    transition: background-color 0.4s var(--ease-cinema);
  }

  .entry:hover::after,
  .entry:focus-visible::after,
  [data-lab-entry].is-active .entry::after {
    background: var(--lab-row-hover);
  }

  .entry:focus-visible {
    outline: none;
  }

  .entry__no {
    grid-area: no;
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    user-select: none;
    transition: color 0.4s var(--ease-cinema);
  }

  .entry:hover .entry__no,
  .entry:focus-visible .entry__no,
  [data-lab-entry].is-active .entry__no {
    color: var(--text-primary);
  }

  .entry__main {
    display: grid;
    grid-area: main;
    gap: 10px;
    min-width: 0;
    transition: transform 0.4s var(--ease-cinema);
  }

  .entry:hover .entry__main,
  .entry:focus-visible .entry__main,
  [data-lab-entry].is-active .entry__main {
    transform: translateX(6px);
  }

  .entry__title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.02em;
  }

  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .entry__tags li {
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .entry__meta {
    display: inline-flex;
    grid-area: meta;
    gap: 8px;
    align-items: baseline;
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .entry__sep {
    opacity: 0.5;
  }

  .entry__arrow {
    grid-area: arrow;
    align-self: center;
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 1.05rem;
    line-height: 1;
    text-align: right;
    transition:
      color 0.4s var(--ease-cinema),
      transform 0.4s var(--ease-cinema);
  }

  .entry:hover .entry__arrow,
  .entry:focus-visible .entry__arrow,
  [data-lab-entry].is-active .entry__arrow {
    color: var(--text-primary);
    transform: translateX(8px);
  }

  .lab-empty {
    padding: 64px 0;
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) and (min-height: 700px) {
    :global(html:has(.lab-page)),
    :global(body:has(.lab-page)) {
      height: 100%;
      overflow: hidden;
    }

    :global(body:has(.lab-page) > main) {
      height: 100dvh;
      overflow: hidden;
    }

    :global(body:has(.lab-page) > .footer) {
      display: none;
    }

    .lab-page {
      height: 100dvh;
      padding-block: clamp(88px, 9vh, 102px)
        clamp(18px, 2.4vh, 28px);
    }

    .lab-masthead {
      position: fixed;
      top: clamp(102px, 10.5vh, 122px);
      left: max(24px, calc(50vw - 660px));
      z-index: 20;
      pointer-events: none;
    }

    .lab-stage {
      height: 100%;
      min-height: 0;
      margin-top: 0;
    }

    .lab-stage::before,
    .lab-stage::after {
      position: absolute;
      right: 0;
      left: 0;
      z-index: 10;
      height: clamp(42px, 6vh, 64px);
      content: "";
      pointer-events: none;
    }

    .lab-stage::before {
      top: 0;
      background: linear-gradient(to bottom, var(--bg), transparent);
    }

    .lab-stage::after {
      bottom: 0;
      background: linear-gradient(to top, var(--bg), transparent);
    }

    .lab-list-viewport {
      height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      contain: layout paint style;
      overflow-anchor: none;
      overscroll-behavior: contain;
      scrollbar-width: none;
      touch-action: pan-y;
    }

    .lab-list-viewport::-webkit-scrollbar {
      display: none;
    }

    .lab-index > [data-cycle] {
      display: block;
    }
  }

  @media (min-width: 1360px) {
    .lab-stage {
      transform: translateX(calc(-1 * var(--lab-stage-shift)));
    }
  }

  @media (max-width: 720px) {
    .entry {
      grid-template-columns: 44px minmax(0, 1fr) 20px;
      grid-template-areas:
        "no main arrow"
        ".  meta meta";
      column-gap: 16px;
      row-gap: 8px;
      padding: 22px 0;
    }

    .entry__no {
      font-size: 0.84rem;
    }

    .entry__title {
      font-size: 1.18rem;
    }

    .entry__meta {
      font-size: 0.72rem;
    }
  }
</style>
