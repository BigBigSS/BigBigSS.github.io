---
import lightA from '../assets/mobile-hero-a.svg?url';
import lightB from '../assets/mobile-hero-b.svg?url';
const blank = 'data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=';
---
<!-- Static SVG surfaces are rasterized once; only the upper image opacity animates. -->
<div class="mobile-hero-art" aria-hidden="true">
  <picture><source media="(max-width:768px)" srcset={lightA} /><img src={blank} alt="" decoding="async" /></picture>
  <picture class="mobile-hero-art__light"><source media="(max-width:768px)" srcset={lightB} /><img src={blank} alt="" decoding="async" /></picture>
</div>
<script>
  function initMobileHero() {
    document.querySelectorAll<HTMLElement>('.mobile-hero-art').forEach((art) => {
      if (art.dataset.bound) return;
      art.dataset.bound = '1';
      const phone = matchMedia('(max-width:768px)');
      const events = new AbortController();
      const options = { signal: events.signal };
      let visible = true;
      const sync = () => { art.classList.toggle('is-paused', !visible || document.hidden || !phone.matches); };
      const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); });
      observer.observe(art);
      phone.addEventListener('change', sync, options);
      document.addEventListener('visibilitychange', sync, options);
      sync();
      document.addEventListener('astro:before-swap', () => {
        events.abort(); observer.disconnect();
      }, { once:true });
    });
  }
  initMobileHero();
  document.addEventListener('astro:page-load', initMobileHero);
</script>
<style>
  .mobile-hero-art { display:none; }
  @media (max-width:768px) {
    .mobile-hero-art { display:block; position:absolute; inset:0; pointer-events:none; z-index:1; overflow:hidden; contain:paint; }
    picture, img { display:block; position:absolute; inset:0; width:100%; height:100%; }
    img { object-fit:fill; }
    .mobile-hero-art__light { will-change:opacity; animation:mobile-light-crossfade 6s ease-in-out -2s infinite alternate; }
    .is-paused .mobile-hero-art__light { animation-play-state:paused; }
    @keyframes mobile-light-crossfade { from { opacity:0; } to { opacity:1; } }
  }
  @media (prefers-reduced-motion:reduce) {
    .mobile-hero-art__light { animation:none; opacity:.5; will-change:auto; }
  }
</style>
