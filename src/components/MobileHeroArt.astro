---
const planetEdge = "M252 -40C354 70 405 255 349 405C319 489 268 548 204 588";
const horizon = "M-45 486C110 512 253 592 445 709";
const middleEdge = "M-35 653C85 567 142 564 237 646C304 701 370 721 445 739";
const foregroundEdge = "M-30 739C97 615 151 563 227 625C296 679 358 710 445 724";
---
<div class="mobile-hero-art" aria-hidden="true">
  <svg viewBox="0 0 402 874" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="mobile-sky" x2="1" y2=".3"><stop stop-color="#06090c"/><stop offset=".7" stop-color="#090d18"/><stop offset="1" stop-color="#151222"/></linearGradient>
      <linearGradient id="mobile-rim" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="590">
        <stop stop-color="#416c9f"/><stop offset=".2" stop-color="#b1c1de"/><stop offset=".36" stop-color="#edc1b7"/><stop offset=".49" stop-color="#f7bca8"/><stop offset=".65" stop-color="#c7a4d2"/><stop offset=".81" stop-color="#9697c5"/><stop offset="1" stop-color="#b3e4fa"/>
      </linearGradient>
      <linearGradient id="mobile-rim-core" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="590">
        <stop stop-color="#7daddb" stop-opacity=".5"/><stop offset=".22" stop-color="#d5e6f6"/><stop offset=".39" stop-color="#fff4de"/><stop offset=".52" stop-color="#ffe5cd"/><stop offset=".7" stop-color="#e4cee8"/><stop offset=".86" stop-color="#c0cdec" stop-opacity=".7"/><stop offset="1" stop-color="#e3f7ff"/>
      </linearGradient>
      <linearGradient id="mobile-volume" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="590">
        <stop stop-color="#315273"/><stop offset=".32" stop-color="#748196"/><stop offset=".48" stop-color="#8f8195"/><stop offset=".7" stop-color="#484967"/><stop offset="1" stop-color="#5686a5"/>
      </linearGradient>
      <linearGradient id="mobile-surface" x1="0" x2="1"><stop stop-color="#05090d"/><stop offset=".58" stop-color="#090e17"/><stop offset=".84" stop-color="#101a2a"/><stop offset="1" stop-color="#263348"/></linearGradient>
      <radialGradient id="mobile-shade" cx="10%" cy="37%" r="95%"><stop offset=".3" stop-color="#04080b"/><stop offset=".65" stop-color="#05090e" stop-opacity=".65"/><stop offset="1" stop-color="#060912" stop-opacity="0"/></radialGradient>
      <radialGradient id="mobile-cold"><stop stop-color="#96d9fa" stop-opacity=".38"/><stop offset="1" stop-color="#599ec2" stop-opacity="0"/></radialGradient>
      <radialGradient id="mobile-warm-window" gradientUnits="userSpaceOnUse" cx="367" cy="263" r="104" gradientTransform="translate(367 263) scale(1 1.15) translate(-367 -263)"><stop stop-color="white"/><stop offset=".32" stop-color="white" stop-opacity=".92"/><stop offset=".7" stop-color="white" stop-opacity=".25"/><stop offset="1" stop-color="white" stop-opacity="0"/></radialGradient>
      <radialGradient id="mobile-cross-window" gradientUnits="userSpaceOnUse" cx="287" cy="625" r="78" gradientTransform="translate(287 625) rotate(30) scale(1 .37) translate(-287 -625)"><stop stop-color="white"/><stop offset=".2" stop-color="white" stop-opacity=".92"/><stop offset=".64" stop-color="white" stop-opacity=".32"/><stop offset="1" stop-color="white" stop-opacity="0"/></radialGradient>
      <mask id="mobile-warm-mask" maskUnits="userSpaceOnUse" x="-60" y="-60" width="540" height="960"><rect class="mobile-hero-art__light-window" x="-60" y="-60" width="540" height="960" fill="url(#mobile-warm-window)"/></mask>
      <mask id="mobile-cross-mask" maskUnits="userSpaceOnUse" x="-60" y="450" width="540" height="350"><rect class="mobile-hero-art__cross-window" x="-60" y="450" width="540" height="350" fill="url(#mobile-cross-window)"/></mask>
      <linearGradient id="mobile-slope-a" gradientUnits="userSpaceOnUse" x1="120" y1="520" x2="80" y2="680"><stop stop-color="#344b66"/><stop offset=".22" stop-color="#1a2b41"/><stop offset=".55" stop-color="#0d1725"/><stop offset="1" stop-color="#06090f"/></linearGradient>
      <linearGradient id="mobile-slope-b" x1=".3" y1="0" x2=".6" y2="1"><stop stop-color="#211e2d"/><stop offset=".2" stop-color="#12121e"/><stop offset=".6" stop-color="#090b12"/><stop offset="1" stop-color="#06090c"/></linearGradient>
      <linearGradient id="mobile-slope-c" x1=".7" y1="0" x2=".4" y2=".75"><stop stop-color="#4d3444"/><stop offset=".16" stop-color="#201929"/><stop offset=".4" stop-color="#0e0e17"/><stop offset="1" stop-color="#06090c"/></linearGradient>
      <linearGradient id="mobile-crosslight" gradientUnits="userSpaceOnUse" x1="0" y1="500" x2="402" y2="680"><stop stop-color="#bfeaff"/><stop offset=".48" stop-color="#e5f3ff"/><stop offset=".68" stop-color="#ffe3c5"/><stop offset=".82" stop-color="#e5a87d"/><stop offset="1" stop-color="#915960"/></linearGradient>
      <linearGradient id="mobile-foreground-rim"><stop stop-color="#465473" stop-opacity=".1"/><stop offset=".27" stop-color="#c79b88" stop-opacity=".6"/><stop offset=".44" stop-color="#9181ba" stop-opacity=".6"/><stop offset=".68" stop-color="#9b6472" stop-opacity=".25"/><stop offset="1" stop-color="#764b53" stop-opacity=".5"/></linearGradient>
      <linearGradient id="mobile-bottom" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#080a0d" stop-opacity="0"/><stop offset="1" stop-color="#080a0d"/></linearGradient>
      <filter id="mobile-light-close" x="-100%" y="-40%" width="300%" height="180%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="1.2"/></filter>
      <filter id="mobile-light-soft" x="-100%" y="-40%" width="300%" height="180%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="4"/></filter>
      <filter id="mobile-light-bloom" x="-100%" y="-40%" width="300%" height="180%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="12"/></filter>
      <filter id="mobile-light-volume" x="-100%" y="-40%" width="300%" height="180%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="24"/></filter>
      <filter id="mobile-grain"><feTurbulence type="fractalNoise" baseFrequency=".82" numOctaves="3" seed="8"/><feColorMatrix type="saturate" values="0"/></filter>
      <clipPath id="mobile-planet-clip"><path d={`${planetEdge}L-60 690V-40Z`}/></clipPath>
      <clipPath id="mobile-slope-clip"><path d={`${horizon}L445 900H-45Z`}/></clipPath>
      <clipPath id="mobile-foreground-clip"><path d={`${foregroundEdge}L445 900H-30Z`}/></clipPath>
    </defs>
    <path fill="url(#mobile-sky)" d="M0 0H402V874H0Z"/>

    <!-- The broad atmosphere stays dim; only the small sun-facing limb is hot. -->
    <path d={planetEdge} fill="none" stroke="url(#mobile-rim)" stroke-width="26" opacity=".32" filter="url(#mobile-light-volume)"/>
    <g class="mobile-hero-art__light" mask="url(#mobile-warm-mask)">
      <path d={planetEdge} fill="none" stroke="#c87384" stroke-width="48" opacity=".57" filter="url(#mobile-light-volume)"/>
      <path d={planetEdge} fill="none" stroke="#ff9666" stroke-width="14" opacity=".8" filter="url(#mobile-light-bloom)"/>
    </g>
    <g clip-path="url(#mobile-planet-clip)">
      <path d="M-60 -40H410V700H-60Z" fill="url(#mobile-surface)"/>
      <path d="M-60 -40H410V700H-60Z" fill="url(#mobile-shade)"/>
      <path d={planetEdge} fill="none" stroke="url(#mobile-volume)" stroke-width="112" opacity=".56" filter="url(#mobile-light-volume)"/>
      <path d={planetEdge} fill="none" stroke="url(#mobile-rim)" stroke-width="40" opacity=".33" filter="url(#mobile-light-bloom)"/>
      <g class="mobile-hero-art__light" mask="url(#mobile-warm-mask)">
        <path d={planetEdge} fill="none" stroke="#ecc2ae" stroke-width="35" opacity=".6" filter="url(#mobile-light-bloom)"/>
      </g>
      <ellipse cx="218" cy="573" rx="122" ry="78" fill="url(#mobile-cold)"/>
      <path d="M0 0H402V700H0Z" filter="url(#mobile-grain)" opacity=".03"/>
    </g>
    <path d={planetEdge} fill="none" stroke="url(#mobile-rim)" stroke-width="5" opacity=".62" filter="url(#mobile-light-soft)"/>
    <path d={planetEdge} fill="none" stroke="url(#mobile-rim-core)" stroke-width=".7" opacity=".85"/>
    <g class="mobile-hero-art__light" mask="url(#mobile-warm-mask)">
      <path d={planetEdge} fill="none" stroke="#ffb274" stroke-width="6" opacity=".8" filter="url(#mobile-light-soft)"/>
      <path d={planetEdge} fill="none" stroke="#ffd29a" stroke-width="2.4" filter="url(#mobile-light-close)"/>
      <path d={planetEdge} fill="none" stroke="#fff4da" stroke-width=".75"/>
    </g>

    <!-- Light follows the same silhouette inside and outside the nearer surface. -->
    <path d={horizon} fill="none" stroke="url(#mobile-crosslight)" stroke-width="20" opacity=".35" filter="url(#mobile-light-bloom)"/>
    <g clip-path="url(#mobile-slope-clip)">
      <path d={`${horizon}L445 900H-45Z`} fill="url(#mobile-slope-a)"/>
      <path d={horizon} fill="none" stroke="url(#mobile-crosslight)" stroke-width="48" opacity=".29" filter="url(#mobile-light-bloom)"/>
      <path d={horizon} fill="none" stroke="url(#mobile-crosslight)" stroke-width="11" opacity=".23" filter="url(#mobile-light-soft)"/>
      {Array.from({length:42}, (_,i) => <path d={`M-45 ${489+i*1.3+(i%3)*.6}C110 ${515+i*2.1} 253 ${595+i*1.4} 445 ${712+i*1.25}`} fill="none" stroke="#9db5c9" stroke-opacity={.018+(i%4)*.006} stroke-width=".4"/>)}
    </g>
    <path d={horizon} fill="none" stroke="url(#mobile-crosslight)" stroke-width="3.5" opacity=".66" filter="url(#mobile-light-close)"/>
    <path d={horizon} fill="none" stroke="url(#mobile-crosslight)" stroke-width=".8"/>
    <g class="mobile-hero-art__cross-light" mask="url(#mobile-cross-mask)">
      <path d={horizon} fill="none" stroke="#da9873" stroke-width="42" opacity=".4" filter="url(#mobile-light-volume)"/>
      <path d={horizon} fill="none" stroke="#ffc28a" stroke-width="12" opacity=".7" filter="url(#mobile-light-bloom)"/>
      <path d={horizon} fill="none" stroke="#ffe3b5" stroke-width="4" opacity=".85" filter="url(#mobile-light-close)"/>
      <path d={horizon} fill="none" stroke="#fff7e9" stroke-width="1"/>
    </g>
    <path d={`${middleEdge}L445 900H-35Z`} fill="url(#mobile-slope-b)"/>
    <path d={middleEdge} fill="none" stroke="url(#mobile-foreground-rim)" stroke-width=".55"/>
    <g clip-path="url(#mobile-foreground-clip)">
      <path d={`${foregroundEdge}L445 900H-30Z`} fill="url(#mobile-slope-c)"/>
      <path d={foregroundEdge} fill="none" stroke="url(#mobile-foreground-rim)" stroke-width="14" opacity=".2" filter="url(#mobile-light-soft)"/>
      {Array.from({length:24}, (_,i) => <path d={`M-30 ${741+i*.8}C97 ${617+i*1.1} 151 ${565+i*1.7} 227 ${627+i*2}C296 ${681+i*2.4} 358 ${712+i*1.7} 445 ${726+i*1.2}`} fill="none" stroke="#82809c" stroke-opacity={.016+(i%4)*.004} stroke-width=".35"/>)}
    </g>
    <path d={foregroundEdge} fill="none" stroke="url(#mobile-foreground-rim)" stroke-width=".5"/>
    {Array.from({length:44}, (_,i) => <circle cx={(i*73+29)%402} cy={470+(i*37)%178} r={i%4===0 ? .45 : .25} fill="#b8d4e5" opacity={.04+(i%5)*.018}/>)}
    <path d="M0 490H402V750H0Z" filter="url(#mobile-grain)" opacity=".022"/>
    <path d="M0 710H402V874H0Z" fill="url(#mobile-bottom)"/>
  </svg>
</div>
<style>
  .mobile-hero-art { display: none; }
  @media (max-width: 768px) {
    .mobile-hero-art { display:block; position:absolute; inset:0; pointer-events:none; z-index:1; overflow:hidden; }
    svg { width:100%; height:100%; }
    .mobile-hero-art__light-window { animation:mobile-limb-drift 6s ease-in-out -2s infinite alternate; }
    .mobile-hero-art__cross-window { animation:mobile-cross-drift 7s ease-in-out -4s infinite alternate; }
    .mobile-hero-art__light { animation:mobile-light-breathe 6s ease-in-out -2s infinite alternate; }
    .mobile-hero-art__cross-light { animation:mobile-light-breathe 7s ease-in-out -4s infinite alternate; }
    /* Move the light mask along the curved edge, keeping the surfaces still. */
    @keyframes mobile-limb-drift {
      0% { transform:translate(-26px,-110px); }
      50% { transform:translate(8px,0); }
      100% { transform:translate(-16px,125px); }
    }
    @keyframes mobile-cross-drift {
      0% { transform:translate(-100px,-56px); }
      50% { transform:translate(-22px,-13px); }
      100% { transform:translate(64px,39px); }
    }
    @keyframes mobile-light-breathe { from { opacity:.52; } to { opacity:1; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-hero-art__light-window, .mobile-hero-art__cross-window, .mobile-hero-art__light, .mobile-hero-art__cross-light { animation:none; }
  }
</style>
