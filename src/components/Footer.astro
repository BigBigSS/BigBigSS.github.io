---
import { site } from "../data/site";

const buildDate = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
}).format(new Date());
const isHome = Astro.url.pathname === "/";
---

<footer class:list={["footer", { "footer--home": isHome }]}>
  <div class="footer__inner">
    <div class="footer__meta">
      <p class="footer__copy">© 2026 {site.name} · {site.slogan}</p>
      <p class="footer__subline"><span>Built with Astro · Source on GitHub</span><span class="footer__date"> · Last updated {buildDate}</span></p>
    </div>

    <div class="footer__links footer__links--secondary">
      <a class="footer-link" href="/#about">关于</a>
      <a class="footer-link" href="/now">最近</a>
      <a class="footer-link" href="/lab">实验室</a>
    </div>

    <div class="footer__links">
      <a class="footer-link" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      <button class="footer-link footer-link--button" type="button" data-email-copy={site.email}>
        <span>Email</span>
      </button>
      <a class="footer-link" href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>

<script>
  let cleanupEmailCopy: (() => void) | undefined;

  const setupEmailCopy = () => {
    cleanupEmailCopy?.();
    const events = new AbortController();
    const timers = new Set<number>();
    const emailCopyButtons = document.querySelectorAll<HTMLButtonElement>("[data-email-copy]");

    emailCopyButtons.forEach((emailCopyButton) => {
      const label = emailCopyButton.querySelector("span") || emailCopyButton;
      const originalLabel = label.textContent || "CONTACT";
      let resetTimer: number | undefined;

      emailCopyButton.addEventListener("click", async () => {
        const email = emailCopyButton.dataset.emailCopy || "";
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          if (events.signal.aborted) return;
          if (resetTimer !== undefined) {
            window.clearTimeout(resetTimer);
            timers.delete(resetTimer);
          }
          label.textContent = "COPIED";
          resetTimer = window.setTimeout(() => {
            label.textContent = originalLabel;
            timers.delete(resetTimer!);
          }, 1400);
          timers.add(resetTimer);
        } catch (_) {
          if (!events.signal.aborted) label.textContent = email;
        }
      }, { signal: events.signal });
    });

    cleanupEmailCopy = () => {
      events.abort();
      timers.forEach((timer) => window.clearTimeout(timer));
    };
  };

  document.addEventListener("astro:page-load", setupEmailCopy);
  document.addEventListener("astro:before-swap", () => cleanupEmailCopy?.());
  setupEmailCopy();
</script>

<style>
  .footer {
    position: relative;
    padding: 64px 24px 56px;
    background: linear-gradient(180deg, transparent 0%, var(--bg-deep) 100%);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: min(1280px, calc(100vw - 48px));
    margin-inline: auto;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-tertiary);
    font-size: 0.92rem;
  }

  .footer__meta {
    display: grid;
    gap: 6px;
  }

  .footer__copy {
    margin: 0;
    color: var(--text-secondary);
  }

  .footer__subline {
    margin: 0;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer__links--secondary {
    margin-left: auto;
  }

  .footer-link {
    color: var(--text-secondary);
    transition: color 160ms ease;
  }

  .footer-link--button {
    appearance: none;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
  }

  .footer-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 700px) {
    .footer {
      padding-inline: 16px;
    }

    .footer__inner {
      width: min(1280px, calc(100vw - 32px));
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__links--secondary {
      margin-left: 0;
    }
  }

  @media (max-width: 768px) {
    .footer--home {
      padding: 32px 24px max(32px, env(safe-area-inset-bottom));
    }

    .footer--home .footer__inner {
      display: grid;
      width: 100%;
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding-top: 24px;
      border-color: color-mix(in srgb, var(--text-primary) 10%, transparent);
    }

    .footer--home .footer__links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 8px;
      margin: 0;
    }

    .footer--home .footer__links--secondary {
      order: -2;
    }

    .footer--home .footer__links:not(.footer__links--secondary) {
      order: -1;
    }

    .footer--home .footer-link {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 8px 4px;
      border: 1px solid color-mix(in srgb, var(--text-primary) 9%, transparent);
      border-radius: 12px;
      font-size: 13px;
      line-height: 1.4;
      text-align: center;
      overflow-wrap: anywhere;
      -webkit-tap-highlight-color: transparent;
    }

    .footer--home .footer__links--secondary .footer-link {
      border-color: transparent;
      background: color-mix(in srgb, var(--text-primary) 4%, transparent);
    }

    .footer--home .footer-link:active {
      background: color-mix(in srgb, var(--text-primary) 8%, transparent);
    }

    .footer--home .footer-link:focus-visible {
      outline: 2px solid var(--text-secondary);
      outline-offset: 3px;
    }

    .footer--home .footer__meta {
      gap: 9px;
      margin-top: 22px;
    }

    .footer--home .footer__copy {
      font-size: 12px;
      line-height: 1.6;
    }

    .footer--home .footer__subline {
      font-size: 10px;
      line-height: 1.9;
    }

    .footer--home .footer__date {
      display: block;
    }
  }
</style>
