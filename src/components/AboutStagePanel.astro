---
import { site } from "../data/site";

const introLines = ["春有百花秋有月", "夏有凉风冬有雪"];
---

<section class="section about-stage" id="about">
  <div class="page-shell about-stage__shell">
    <p class="about-stage__eyebrow">02 / IDENTITÉ</p>

    <div class="about-stage__spot" data-about-stage>
      <div class="about-stage__card" data-about-card>
        <!-- Glassmorphism backdrop layer (Z = -50px) -->
        <div class="about-stage__backdrop"></div>

        <!-- Default: trigger text layer (Z = 20px) -->
        <div class="about-stage__trigger-wrap">
          <h2 class="about-stage__trigger" data-about-trigger tabindex="0">
            {
              introLines.map((line) => (
                <span data-poetry-line>{line}</span>
              ))
            }
          </h2>
        </div>

        <!-- Hover: revealed panel layer (Z = 60px) -->
        <div class="about-stage__panel" data-about-panel>
          <div class="about-stage__panel-inner">
            <div class="about-stage__copy-layer about-stage__copy-layer--base">
              <h2 class="about-stage__title">
                Hello，我是 {site.name}
              </h2>
              <p class="about-stage__subtitle">
                <span>一名来自武汉的软件工程师。</span>
                <span>这里记录了我热爱的生活与工作，may you have a beautiful day here.</span>
              </p>
            </div>

            <div class="about-stage__copy-layer about-stage__copy-layer--lens" aria-hidden="true">
              <h2 class="about-stage__title">
                你好，I am {site.name}
              </h2>
              <p class="about-stage__subtitle">
                <span>A software engineer from Wuhan.</span>
                <span>Here I keep the life and work I love，希望来到这里的你拥有美好的一天。</span>
              </p>
            </div>

            <div class="about-stage__lens" aria-hidden="true" data-about-lens></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const initAboutStage = () => {
  const mobileViewport = window.matchMedia("(max-width: 768px)");
  const coarsePointer = window.matchMedia("(pointer: coarse)");
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const poemLengthLimit = 18;
  const localPoemSeeds = [
    ["行到水穷处", "坐看云起时"],
    ["山中何所有", "岭上多白云"],
  ];
  const fallbackPoem = ["春有百花秋有月", "夏有凉风冬有雪"];

  const cleanPoemLine = (line: string) =>
    line
      .replace(/[，。！？；：、,.!?;:\s]+$/g, "")
      .trim();

  const splitPoemLine = (line: string) =>
    line
      .split(/[，。！？；：、,.!?;:\s]+/g)
      .map(cleanPoemLine)
      .filter(Boolean);

  const pickTwoLines = (content: string[] = []) => {
    const directLines = content.map(cleanPoemLine).filter(Boolean);
    if (directLines.length >= 2) return directLines.slice(0, 2);

    const splitLines = content.flatMap(splitPoemLine);
    if (splitLines.length >= 2) return splitLines.slice(0, 2);

    return fallbackPoem;
  };

  const syncPoemFontSize = (stage: HTMLElement, trigger: HTMLElement, lines: string[]) => {
    const stageWidth = stage.getBoundingClientRect().width || window.innerWidth;
    const longestLine = Math.max(...lines.map((line) => line.length), 1);
    if (mobileViewport.matches) {
      const availableWidth = trigger.clientWidth || stageWidth - 42;
      const mobileSize = Math.min(34, Math.max(12, Math.floor(availableWidth / (longestLine * 1.025))));
      trigger.style.setProperty("--poem-font-size", `${mobileSize}px`);
      return;
    }
    const maxSize = Math.min(window.innerWidth < 640 ? 74 : 128, stageWidth / 2.7);
    const fittedSize = Math.floor((stageWidth * 0.9) / (longestLine * 1.02));
    const nextSize = Math.max(28, Math.min(maxSize, fittedSize));
    trigger.style.setProperty("--poem-font-size", `${nextSize}px`);
  };

  // 一次性加载构建时生成的诗词池（静态文件），失败则回退到本地种子。
  let poemPoolPromise: Promise<string[][]> | null = null;
  const loadPoemPool = () => {
    if (!poemPoolPromise) {
      poemPoolPromise = fetch("/api/random-poem.json", {
        headers: { accept: "application/json" },
      })
        .then((response) => response.json())
        .then((payload: { poems?: string[][] }) => {
          const poems = Array.isArray(payload?.poems) ? payload.poems : [];
          const cleaned = poems
            .map((lines) => pickTwoLines(lines))
            .filter((lines) => lines.length >= 2);
          return cleaned.length ? cleaned : localPoemSeeds.map((lines) => [...lines]);
        })
        .catch(() => localPoemSeeds.map((lines) => [...lines]));
    }
    return poemPoolPromise;
  };

  const applyStagePoem = (stage: HTMLElement, lines: string[]) => {
    const trigger = stage.querySelector<HTMLElement>("[data-about-trigger]");
    if (!trigger) return;

    const nextLines = lines.length >= 2 ? lines : fallbackPoem;
    const isStacked = nextLines.join("").length > poemLengthLimit;

    trigger.classList.toggle("is-stacked", isStacked);
    syncPoemFontSize(stage, trigger, nextLines);
    trigger.replaceChildren(
      ...nextLines.map((line) => {
        const item = document.createElement("span");
        item.dataset.poetryLine = "";
        item.textContent = line;
        return item;
      }),
    );
  };

  document.querySelectorAll<HTMLElement>("[data-about-stage]").forEach((stage) => {
    const card = stage.querySelector<HTMLElement>("[data-about-card]");
    const trigger = stage.querySelector<HTMLElement>("[data-about-trigger]");
    const panel = stage.querySelector<HTMLElement>("[data-about-panel]");
    const lens = stage.querySelector<HTMLElement>("[data-about-lens]");
    const lensRoot = lens?.parentElement as HTMLElement | null;
    if (!card || !trigger || stage.dataset.initialized === "1") return;
    stage.dataset.initialized = "1";
    const events = new AbortController();
    const poemFace = trigger.parentElement!;
    let poemAnimation: Animation | null = null;
    const trackingRoot = stage.closest<HTMLElement>(".about-stage") ?? stage;
    // 诗词池：客户端只拉一次，之后每次切换在本地随机挑（避免与上一首重复），循环不停。
    const introLineKey = Array.from(
      trigger.querySelectorAll<HTMLElement>("[data-poetry-line]"),
    )
      .map((item) => item.textContent || "")
      .filter(Boolean)
      .join("|");
    let poemPool: string[][] = localPoemSeeds.map((lines) => [...lines]);
    let poemOrder: number[] = [];
    let lastPoemKey = introLineKey;

    const reshufflePoemOrder = () => {
      poemOrder = poemPool.map((_, index) => index);
      for (let i = poemOrder.length - 1; i > 0; i -= 1) {
        const j = Math.floor(Math.random() * (i + 1));
        [poemOrder[i], poemOrder[j]] = [poemOrder[j], poemOrder[i]];
      }
      // 新一轮的第一首避免与刚展示过的重复
      if (poemOrder.length > 1 && poemPool[poemOrder[0]].join("|") === lastPoemKey) {
        [poemOrder[0], poemOrder[1]] = [poemOrder[1], poemOrder[0]];
      }
    };

    const nextPoemLines = () => {
      if (!poemOrder.length) reshufflePoemOrder();
      const index = poemOrder.shift();
      const lines = (index != null ? poemPool[index] : null) ?? fallbackPoem;
      lastPoemKey = lines.join("|");
      return lines;
    };

    const showNextPoem = () => {
      poemAnimation?.cancel();
      applyStagePoem(stage, nextPoemLines());
      if (mobileViewport.matches && !motionPreference.matches) {
        poemAnimation = trigger.animate(
          [
            { opacity: 0.2, transform: "translateY(7px)", filter: "blur(3px)" },
            { opacity: 1, transform: "translateY(0)", filter: "blur(0)" },
          ],
          { duration: 560, easing: "cubic-bezier(0.2, 0.65, 0.3, 1)" },
        );
      }
    };

    void loadPoemPool().then((loaded) => {
      if (!events.signal.aborted && loaded.length) {
        poemPool = loaded;
        poemOrder = [];
      }
    });

    window.addEventListener("theme-change", () => {
      showNextPoem();
    }, { signal: events.signal });

    const fitCurrentPoem = () => {
      const lines = Array.from(trigger.querySelectorAll<HTMLElement>("[data-poetry-line]"))
        .map((item) => item.textContent || "")
        .filter(Boolean);
      if (lines.length) syncPoemFontSize(stage, trigger, lines);
    };
    window.addEventListener("resize", fitCurrentPoem, { signal: events.signal });

    const revealStage = () => {
      if (mobileViewport.matches) return;
      stage.classList.add("is-active");
    };

    const hideStage = () => {
      if (mobileViewport.matches) return;
      stage.classList.remove("is-active");
      panel?.classList.remove("is-lens-active");
    };

    // Reveal only starts from the poem text itself.
    const onTriggerOver = (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (target && target.hasAttribute("data-poetry-line")) {
        revealStage();
      }
    };
    trigger.addEventListener("mouseover", onTriggerOver as EventListener);
    stage.addEventListener("mouseleave", hideStage);

    // focus support for keyboard accessibility
    trigger.addEventListener("focus", revealStage);
    trigger.addEventListener("blur", hideStage);

    const syncLens = (event: PointerEvent) => {
      if (mobileViewport.matches) return;
      if (!panel || !lens || !lensRoot || !stage.classList.contains("is-active")) return;
      const rect = lensRoot.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      lensRoot.style.setProperty("--lens-x", `${x}px`);
      lensRoot.style.setProperty("--lens-y", `${y}px`);
      panel.classList.add("is-lens-active");
    };

    const hideLens = () => {
      panel?.classList.remove("is-lens-active");
    };

    panel?.addEventListener("pointermove", syncLens);
    panel?.addEventListener("pointerleave", hideLens);

    // Mobile: one card, tap to switch faces; hold the introduction to inspect it.
    let mobileIntro = false;
    let holdTimer = 0;
    let held = false;
    let gestureMoved = false;
    let suppressClick = false;
    let activePointer: number | null = null;
    let startX = 0;
    let startY = 0;

    const syncMobileFaces = () => {
      const mobile = mobileViewport.matches;
      stage.classList.toggle("is-mobile-intro", mobile && mobileIntro);
      poemFace.inert = mobile && mobileIntro;
      if (panel) panel.inert = mobile && !mobileIntro;
      if (mobile) {
        card.setAttribute("role", "button");
        card.tabIndex = 0;
        card.setAttribute("aria-pressed", String(mobileIntro));
        card.setAttribute("aria-label", mobileIntro
          ? "个人介绍，长按探索放大镜，点击返回下一首诗词"
          : `${lastPoemKey.replaceAll("|", "，")}，点击查看个人介绍`);
        poemFace.setAttribute("aria-hidden", String(mobileIntro));
        panel?.setAttribute("aria-hidden", String(!mobileIntro));
      } else {
        ["role", "tabindex", "aria-pressed", "aria-label"].forEach((name) => card.removeAttribute(name));
        poemFace.removeAttribute("aria-hidden");
        panel?.removeAttribute("aria-hidden");
      }
    };

    const endHold = () => {
      window.clearTimeout(holdTimer);
      holdTimer = 0;
      if (held || gestureMoved) suppressClick = true;
      held = false;
      activePointer = null;
      if (mobileViewport.matches) hideLens();
    };

    const moveTouchLens = (clientX: number, clientY: number) => {
      if (!lensRoot || !panel) return;
      const rect = lensRoot.getBoundingClientRect();
      // A small upward offset keeps the lens visible above the fingertip.
      const x = Math.max(24, Math.min(rect.width - 24, clientX - rect.left));
      const y = Math.max(24, Math.min(rect.height - 24, clientY - rect.top - 42));
      lensRoot.style.setProperty("--lens-x", `${x}px`);
      lensRoot.style.setProperty("--lens-y", `${y}px`);
      panel.classList.add("is-lens-active");
    };

    card.addEventListener("pointerdown", (event) => {
      if (!mobileViewport.matches) return;
      if (!event.isPrimary || event.button !== 0 || activePointer !== null) {
        gestureMoved = true;
        endHold();
        return;
      }
      suppressClick = false;
      gestureMoved = false;
      activePointer = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      if (!mobileIntro) return;
      holdTimer = window.setTimeout(() => {
        holdTimer = 0;
        held = true;
        suppressClick = true;
        moveTouchLens(startX, startY);
      }, 420);
    }, { signal: events.signal });

    card.addEventListener("pointermove", (event) => {
      if (!mobileViewport.matches || event.pointerId !== activePointer) return;
      if (held) {
        moveTouchLens(event.clientX, event.clientY);
      } else if (Math.hypot(event.clientX - startX, event.clientY - startY) > 9) {
        gestureMoved = true;
        endHold();
      }
    }, { signal: events.signal });

    // Before the hold, normal vertical scrolling wins. After the hold, only
    // this gesture is reserved for the lens (including Safari's touch stream).
    card.addEventListener("touchmove", (event) => {
      if (!mobileViewport.matches || !held || event.touches.length !== 1) return;
      if (event.cancelable) event.preventDefault();
      moveTouchLens(event.touches[0].clientX, event.touches[0].clientY);
    }, { passive: false, signal: events.signal });
    card.addEventListener("touchstart", (event) => {
      if (mobileViewport.matches && event.touches.length > 1) {
        gestureMoved = true;
        endHold();
      }
    }, { passive: true, signal: events.signal });
    ["pointerup", "touchend"].forEach((name) => {
      window.addEventListener(name, endHold, { signal: events.signal });
    });
    ["pointercancel", "touchcancel", "lostpointercapture"].forEach((name) => {
      card.addEventListener(name, () => {
        if (mobileViewport.matches && activePointer !== null) gestureMoved = true;
        endHold();
      }, { signal: events.signal });
    });
    card.addEventListener("pointerleave", () => {
      if (mobileViewport.matches && activePointer !== null) {
        gestureMoved = true;
        endHold();
      }
    }, { signal: events.signal });
    card.addEventListener("contextmenu", (event) => {
      if (mobileViewport.matches) event.preventDefault();
    }, { signal: events.signal });
    window.addEventListener("scroll", () => {
      if (mobileViewport.matches && activePointer !== null) {
        gestureMoved = true;
        endHold();
      }
    }, { passive: true, signal: events.signal });
    window.addEventListener("blur", endHold, { signal: events.signal });
    document.addEventListener("visibilitychange", endHold, { signal: events.signal });

    const toggleMobileCard = () => {
      endHold();
      mobileIntro = !mobileIntro;
      if (!mobileIntro) showNextPoem();
      syncMobileFaces();
    };
    card.addEventListener("click", (event) => {
      if (!mobileViewport.matches) return;
      if (suppressClick) {
        event.preventDefault();
        suppressClick = false;
        return;
      }
      toggleMobileCard();
    }, { signal: events.signal });
    card.addEventListener("keydown", (event) => {
      if (!mobileViewport.matches || (event.key !== "Enter" && event.key !== " ")) return;
      event.preventDefault();
      if (!event.repeat) toggleMobileCard();
    }, { signal: events.signal });

    const shouldTrack3d = () => !mobileViewport.matches && !coarsePointer.matches && !motionPreference.matches;

    // ── 3D mouse tracking ──
    let frame = 0;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const update = () => {
      frame = 0;
      if (!shouldTrack3d()) return;
      currentX += (targetX - currentX) * 0.05;
      currentY += (targetY - currentY) * 0.05;

      const rotateX = (-currentY * 15).toFixed(2);
      const rotateY = (currentX * 15).toFixed(2);
      card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;

      if (Math.abs(targetX - currentX) > 0.001 || Math.abs(targetY - currentY) > 0.001) {
        frame = window.requestAnimationFrame(update);
      }
    };

    const schedule = () => {
      if (!frame) {
        frame = window.requestAnimationFrame(update);
      }
    };

    const onMove = (event: PointerEvent) => {
      if (!shouldTrack3d()) return;
      const rect = trackingRoot.getBoundingClientRect();
      targetX = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      targetY = ((event.clientY - rect.top) / rect.height) * 2 - 1;
      schedule();
    };

    const onLeave = () => {
      if (!shouldTrack3d()) return;
      targetX = 0;
      targetY = 0;
      schedule();
    };

    trackingRoot.addEventListener("pointermove", onMove);
    trackingRoot.addEventListener("pointerleave", onLeave);
    trackingRoot.addEventListener("pointercancel", onLeave);

    const syncInteractionMode = () => {
      endHold();
      mobileIntro = false;
      stage.classList.remove("is-active");
      hideLens();
      syncMobileFaces();
      if (frame) window.cancelAnimationFrame(frame);
      frame = 0;
      targetX = targetY = currentX = currentY = 0;
      card.style.removeProperty("transform");
      // Keep the original coarse-pointer desktop presentation outside the mobile breakpoint.
      card.classList.toggle("mobile-float", !mobileViewport.matches && coarsePointer.matches && !motionPreference.matches);
      trigger.tabIndex = mobileViewport.matches ? -1 : 0;
      if (mobileViewport.matches) {
        trigger.setAttribute("aria-live", "polite");
        trigger.setAttribute("aria-atomic", "true");
      } else {
        trigger.removeAttribute("aria-live");
        trigger.removeAttribute("aria-atomic");
      }
      if (motionPreference.matches) poemAnimation?.cancel();
      if (mobileViewport.matches || trigger.style.getPropertyValue("--poem-font-size")) fitCurrentPoem();
    };
    mobileViewport.addEventListener("change", syncInteractionMode, { signal: events.signal });
    coarsePointer.addEventListener("change", syncInteractionMode, { signal: events.signal });
    motionPreference.addEventListener("change", syncInteractionMode, { signal: events.signal });
    syncInteractionMode();

    document.addEventListener(
      "astro:before-swap",
      () => {
        endHold();
        events.abort();
        poemAnimation?.cancel();
        if (frame) window.cancelAnimationFrame(frame);
        trigger.removeEventListener("mouseover", onTriggerOver as EventListener);
        stage.removeEventListener("mouseleave", hideStage);
        trigger.removeEventListener("focus", revealStage);
        trigger.removeEventListener("blur", hideStage);
        panel?.removeEventListener("pointermove", syncLens);
        panel?.removeEventListener("pointerleave", hideLens);
        trackingRoot.removeEventListener("pointermove", onMove);
        trackingRoot.removeEventListener("pointerleave", onLeave);
        trackingRoot.removeEventListener("pointercancel", onLeave);
      },
      { once: true },
    );
  });
  };
  initAboutStage();
  document.addEventListener("astro:page-load", initAboutStage);
</script>

<style>
  /* Mobile float animation (matching demo2) */
  @keyframes float3d {
    0% { transform: rotateX(5deg) rotateY(-5deg) translateY(0); }
    50% { transform: rotateX(-5deg) rotateY(5deg) translateY(-15px); }
    100% { transform: rotateX(5deg) rotateY(-5deg) translateY(0); }
  }

  .about-stage {
    min-height: clamp(340px, 48vh, 520px);
    display: flex;
    align-items: center;
    padding-top: clamp(76px, 9vw, 128px);
  }

  .about-stage__shell {
    width: var(--container);
  }

  .about-stage__eyebrow {
    margin: 0 0 22px;
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* — Container with perspective — */
  .about-stage__spot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 90vw;
    margin: 0 auto;
    min-height: clamp(260px, 40vh, 420px);
    perspective: 1500px;
  }

  /* — Card wrapper: 3D transforms applied here — */
  .about-stage__card {
    position: relative;
    width: 100%;
    min-height: clamp(260px, 40vh, 420px);
    display: flex;
    align-items: center;
    justify-content: center;
    transform-style: preserve-3d;
    will-change: transform;
    transition: transform 100ms linear;
  }

  .about-stage__card:global(.mobile-float) {
    animation: float3d 8s ease-in-out infinite;
  }

  /* — Glassmorphism backdrop (Z = -50px) — */
  .about-stage__backdrop {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 24px;
    background: rgba(17, 17, 17, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 40px rgba(255, 255, 255, 0.03);
    opacity: 0;
    transform: scale(0.9) translateZ(-50px);
    transition: all 1000ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .about-stage__spot:global(.is-active) .about-stage__backdrop {
    opacity: 1;
    transform: scale(1) translateZ(-50px);
  }

  :global(body.light-mode) .about-stage__backdrop {
    background: rgba(255, 255, 255, 0.4);
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow: 0 20px 60px -15px rgba(0, 0, 0, 0.05);
  }

  /* — Trigger text layer (Z = 20px) — */
  .about-stage__trigger-wrap {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    opacity: 1;
    transform: translateY(0) scale(1) translateZ(20px);
    filter: blur(0);
    transition:
      opacity 1200ms cubic-bezier(0.19, 1, 0.22, 1),
      transform 1200ms cubic-bezier(0.19, 1, 0.22, 1),
      filter 1200ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .about-stage__spot:global(.is-active) .about-stage__trigger-wrap {
    opacity: 0;
    transform: translateY(-80px) scale(0.95) translateZ(20px);
    filter: blur(16px);
    pointer-events: none;
  }

  .about-stage__trigger {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.16em 0.26em;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font-size: var(--poem-font-size, clamp(2.4rem, 8vw, 8rem));
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-align: center;
  }

  .about-stage__trigger:global(.is-stacked) {
    display: grid;
    gap: 0.12em;
  }

  .about-stage__trigger span {
    display: block;
    white-space: nowrap;
    cursor: pointer;
  }

  .about-stage__trigger:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 75%, white 15%);
    outline-offset: 8px;
    border-radius: 8px;
  }

  /* — Revealed panel layer (Z = 60px) — */
  .about-stage__panel {
    --lens-size: 148px;
    --lens-x: 50%;
    --lens-y: 50%;
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0 24px;
    opacity: 0;
    transform: translateY(80px) scale(1.05) translateZ(60px);
    filter: blur(16px);
    pointer-events: none;
    transition:
      opacity 1200ms cubic-bezier(0.19, 1, 0.22, 1) 75ms,
      transform 1200ms cubic-bezier(0.19, 1, 0.22, 1) 75ms,
      filter 1200ms cubic-bezier(0.19, 1, 0.22, 1) 75ms;
  }

  .about-stage__panel:global(.is-lens-active) {
    cursor: none;
  }

  .about-stage__spot:global(.is-active) .about-stage__panel {
    opacity: 1;
    transform: translateY(0) scale(1) translateZ(60px);
    filter: blur(0);
    pointer-events: auto;
  }

