---
import type { CollectionEntry } from "astro:content";
import { formatCompactDate } from "../lib/content";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  labs: CollectionEntry<"labs">[];
}

const { labs } = Astro.props;
---

<section class="section writing-spotlight" id="writing">
  <div class="page-shell">
    <div class="writing-spotlight__header">
      <SectionHeading index="04" label="LABORATORY" title="LABORATORY" />
      <span class="writing-spotlight__hint">INTERACTIVE SURFACE</span>
    </div>

    <div class="writing-spotlight__grid" data-writing-spotlight>
      {
        labs.map((lab, index) => (
          <article
            class:list={[
              "writing-spotlight__card",
              { "writing-spotlight__card--feature": index === 0 },
            ]}
            data-writing-card
          >
            <div class="writing-spotlight__card-surface">
              <a class="writing-spotlight__link" href={`/lab/${lab.id}`}>
                {lab.data.cover && (
                  <div class="writing-spotlight__cover" aria-hidden="true">
                    <img src={lab.data.cover} alt="" loading="lazy" decoding="async" width="640" height="400" />
                  </div>
                )}
                <div class="writing-spotlight__top">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span>{formatCompactDate(lab.data.date)}</span>
                </div>

                <div class="writing-spotlight__body">
                  <h3>{lab.data.title}</h3>
                  <p>{lab.data.description}</p>
                </div>

                <ul class="tag-list">
                  {lab.data.tags.map((tag) => <li class="tag-pill">{tag}</li>)}
                </ul>
                <span class="writing-spotlight__mobile-arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 18 18 6M6 6h12v12" />
                  </svg>
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  let spotlightCleanups: Array<() => void> = [];

  const cleanupSpotlight = () => {
    spotlightCleanups.forEach((cleanup) => cleanup());
    spotlightCleanups = [];
  };

  // 触屏直接点击进入；仅桌面精细指针启用跟随光，并响应断点变化。
  const initSpotlight = () => {
    cleanupSpotlight();
    document.querySelectorAll<HTMLElement>("[data-writing-spotlight]").forEach((root) => {
      const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-writing-card]"));
      if (!cards.length) {
        return;
      }

      const reset = () => {
        cards.forEach((card) => {
          card.style.setProperty("--mouse-x", `${card.clientWidth / 2}px`);
          card.style.setProperty("--mouse-y", `${card.clientHeight / 2}px`);
        });
      };

      const onMove = (event: PointerEvent) => {
        if (event.pointerType === "touch") return;
        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty("--mouse-x", `${event.clientX - rect.left}px`);
          card.style.setProperty("--mouse-y", `${event.clientY - rect.top}px`);
        });
      };

      const desktopPointer = window.matchMedia("(min-width: 769px) and (hover: hover) and (pointer: fine)");
      const syncPointer = () => {
        root.removeEventListener("pointermove", onMove);
        root.removeEventListener("pointerleave", reset);
        if (desktopPointer.matches) {
          reset();
          root.addEventListener("pointermove", onMove);
          root.addEventListener("pointerleave", reset);
        } else {
          cards.forEach((card) => {
            card.style.removeProperty("--mouse-x");
            card.style.removeProperty("--mouse-y");
          });
        }
      };

      syncPointer();
      desktopPointer.addEventListener("change", syncPointer);
      spotlightCleanups.push(() => {
        root.removeEventListener("pointermove", onMove);
        root.removeEventListener("pointerleave", reset);
        desktopPointer.removeEventListener("change", syncPointer);
      });
    });
  };

  document.addEventListener("astro:page-load", initSpotlight);
  document.addEventListener("astro:before-swap", cleanupSpotlight);

  // 卡片跳转交给 ClientRouter 处理：lab 详情页依赖自身脚本（全屏/重置等），
  // 手写 innerHTML 换正文的转场不会加载目标页脚本，会把演示页搞成半残。
</script>

<style>
  .writing-spotlight__cover,
  .writing-spotlight__mobile-arrow {
    display: none;
  }

  .writing-spotlight {
    --card-base-bg: rgba(255, 255, 255, 0.05);
    --card-content-bg: rgb(10, 10, 10);
    --spotlight-inner: rgba(255, 255, 255, 0.03);
    --spotlight-outer: rgba(255, 255, 255, 0.45);
    padding-bottom: clamp(80px, 9vw, 140px);
  }

  :global(body.light-mode) .writing-spotlight {
    --card-base-bg: rgba(0, 0, 0, 0.075);
    --card-content-bg: rgb(250, 250, 250);
    --spotlight-inner: rgba(0, 0, 0, 0.055);
    --spotlight-outer: rgba(0, 0, 0, 0.42);
  }

  .writing-spotlight__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(body.light-mode) .writing-spotlight__header {
    border-bottom-color: rgba(0, 0, 0, 0.12);
  }

  .writing-spotlight__hint {
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .writing-spotlight__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 22px;
    margin-bottom: clamp(28px, 4vw, 56px);
  }

  .writing-spotlight__card {
    position: relative;
    background: var(--card-base-bg);
    overflow: hidden;
  }

  .writing-spotlight__card {
    box-shadow: inset 0 0 0 1px var(--card-base-bg);
  }

  .writing-spotlight__card--feature {
    grid-column: span 2;
  }

  .writing-spotlight__card::before,
  .writing-spotlight__card::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .writing-spotlight__card::before {
    background:
      radial-gradient(
        760px circle at var(--mouse-x) var(--mouse-y),
        var(--spotlight-inner),
        transparent 40%
      );
    z-index: 3;
  }

  .writing-spotlight__card::after {
    padding: 1px;
    background:
      radial-gradient(
        560px circle at var(--mouse-x) var(--mouse-y),
        var(--spotlight-outer),
        transparent 40%
      );
    z-index: 4;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  .writing-spotlight__grid:hover > .writing-spotlight__card::after,
  .writing-spotlight__card:hover::before,
  .writing-spotlight__card:hover::after,
  .writing-spotlight__card:focus-within::before,
  .writing-spotlight__card:focus-within::after {
    opacity: 1;
  }

  .writing-spotlight__card-surface {
    position: relative;
    z-index: 2;
    display: flex;
    min-height: 100%;
    background: var(--card-content-bg);
    box-shadow: inset 0 0 0 1px var(--card-base-bg);
    transition: background-color 0.5s ease;
  }

  .writing-spotlight__link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 300px;
    padding: 24px 22px 28px;
  }

  .writing-spotlight__card--feature .writing-spotlight__link {
    min-height: 320px;
  }

  .writing-spotlight .tag-list {
    padding-bottom: 2px;
  }

  .writing-spotlight__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-tertiary);
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .writing-spotlight__body h3 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(1.35rem, 2.1vw, 2rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }

  .writing-spotlight__body p {
    margin: 10px 0 0;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .writing-spotlight__link,
    .writing-spotlight__card--feature .writing-spotlight__link {
      min-height: 250px;
      padding: 22px 20px 24px;
    }
  }

  @media (max-width: 980px) {
    .writing-spotlight__grid {
      grid-template-columns: 1fr 1fr;
    }

    .writing-spotlight__card--feature {
      grid-column: span 2;
    }
  }

  @media (max-width: 720px) {
    .writing-spotlight__header {
      flex-direction: column;
      align-items: flex-start;
    }

    .writing-spotlight__grid {
      grid-template-columns: 1fr;
    }

    .writing-spotlight__card--feature {
      grid-column: auto;
    }
  }

  @media (max-width: 768px) {
    .writing-spotlight {
      padding-block: 72px;
    }

    .writing-spotlight > .page-shell {
      width: calc(100% - 48px);
    }

    .writing-spotlight__header {
      display: block;
      padding-bottom: 24px;
    }

    .writing-spotlight__header :global(.eyebrow) {
      margin-bottom: 14px;
      font-size: 10px;
      letter-spacing: 0.14em;
    }

    .writing-spotlight__header :global(.section-title) {
      font-size: 32px;
      font-weight: 500;
      line-height: 1.1;
      letter-spacing: -0.045em;
    }

    .writing-spotlight__hint {
      display: block;
      margin-top: 14px;
      font-size: 9px;
      letter-spacing: 0.1em;
    }

    .writing-spotlight__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      margin: 24px 0 0;
    }

    .writing-spotlight__card,
    .writing-spotlight__card-surface {
      min-width: 0;
      background: transparent;
      box-shadow: none;
      overflow: visible;
    }

    .writing-spotlight__card {
      border-bottom: 1px solid var(--border);
    }

    .writing-spotlight__card::before,
    .writing-spotlight__card::after {
      display: none;
    }

    .writing-spotlight__link {
      position: relative;
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 16px;
      row-gap: 9px;
      align-items: start;
      min-height: 0;
      padding: 24px 0;
      -webkit-tap-highlight-color: transparent;
      transition: opacity 160ms ease;
    }

    .writing-spotlight__link:active {
      opacity: 0.65;
    }

    .writing-spotlight__link:focus-visible {
      outline: 1px solid var(--text-secondary);
      outline-offset: 5px;
      border-radius: 12px;
    }

    .writing-spotlight__cover {
      display: block;
      grid-column: 1;
      grid-row: 1 / 4;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: 12px;
      background: #11141a;
      border: 1px solid rgba(255, 255, 255, 0.07);
    }

    .writing-spotlight__cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .writing-spotlight__top {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-start;
      gap: 12px;
      padding-right: 20px;
      font-size: 9px;
      letter-spacing: 0.055em;
      line-height: 1.4;
    }

    .writing-spotlight__body {
      grid-column: 2;
      grid-row: 2;
      min-width: 0;
    }

    .writing-spotlight__body h3 {
      max-width: none;
      font-size: 18px;
      line-height: 1.4;
      font-weight: 500;
      letter-spacing: -0.025em;
      text-transform: none;
      overflow-wrap: anywhere;
    }

    .writing-spotlight__body p {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      margin-top: 7px;
      font-size: 12px;
      line-height: 1.7;
    }

    .writing-spotlight .tag-list {
      grid-column: 2;
      grid-row: 3;
      gap: 5px 7px;
      padding: 0;
    }

    .writing-spotlight .tag-pill {
      padding: 0;
      border: 0;
      background: transparent;
      font-size: 8px;
      line-height: 1.6;
      letter-spacing: 0.055em;
      color: var(--text-tertiary);
    }

    .writing-spotlight .tag-pill::before,
    .writing-spotlight .tag-pill::after {
      display: none;
    }

    .writing-spotlight__mobile-arrow {
      display: flex;
      position: absolute;
      top: 22px;
      right: 0;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      color: var(--text-secondary);
    }

    .writing-spotlight__card--feature {
      grid-column: auto;
      padding-bottom: 8px;
    }

    .writing-spotlight__card--feature .writing-spotlight__link {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto auto;
      gap: 16px;
      min-height: 0;
      padding: 0 0 24px;
    }

    .writing-spotlight__card--feature .writing-spotlight__cover {
      grid-row: 1;
      aspect-ratio: 16 / 10;
      border-radius: 18px;
    }

    .writing-spotlight__card--feature .writing-spotlight__top {
      grid-column: 1;
      grid-row: 2;
      padding-right: 0;
    }

    .writing-spotlight__card--feature .writing-spotlight__body {
      grid-column: 1;
      grid-row: 3;
    }

    .writing-spotlight__card--feature .writing-spotlight__body h3 {
      font-size: 22px;
      line-height: 1.4;
    }

    .writing-spotlight__card--feature .writing-spotlight__body p {
      -webkit-line-clamp: 3;
      margin-top: 10px;
      font-size: 13px;
      line-height: 1.8;
    }

    .writing-spotlight__card--feature .tag-list {
      grid-column: 1;
      grid-row: 4;
    }

    .writing-spotlight__card--feature .tag-pill {
      font-size: 9px;
    }

    .writing-spotlight__card--feature .writing-spotlight__mobile-arrow {
      top: 12px;
      right: 12px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      color: #f4f4f5;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(10, 12, 16, 0.72);
    }
  }
</style>
